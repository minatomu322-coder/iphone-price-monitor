# ローカル開発用の環境変数サンプル。
# 実際の値を入れて `.env` にコピーし、`export $(cat .env | xargs)` などで読み込んでください。
# 本番 (Render) ではダッシュボードの Environment に設定します。

# LINE Developers > Messaging API チャネル
CHANNEL_SECRET=your_channel_secret
CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token

# 管理者の LINE userId (カンマ区切りで複数可)
# 自分の userId は、BOT に何かメッセージを送った際の Webhook ログ、
# または LINE Developers の「あなたのユーザーID」から確認できます。
ADMIN_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DB 接続文字列。未設定ならローカル SQLite (lottery.db) を使用。
# 本番では Render の PostgreSQL が自動注入されます。
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
